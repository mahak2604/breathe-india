          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Comparing spring 2020 with spring 2019 says PM2.5 fell ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#52514E"
                    }
                  },
                  {
                    "value": "41%",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#52514E",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ". But spring 2020 also had kinder weather. Our model, trained on 2015–2019, predicts what pollution should have been given the actual weather. Against that, the real lockdown effect was ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#52514E"
                    }
                  },
                  {
                    "value": "−28%",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#52514E",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ": about ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#52514E"
                    }
                  },
                  {
                    "value": "a third of the headline drop was weather",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#52514E",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ". NO₂, mostly from traffic, fell ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#52514E"
                    }
                  },
                  {
                    "value": "46%",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#52514E",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " either way.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#52514E"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
