      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "_Measures",
        "lineageTag": "2ffa7155-4ac1-5e6f-ac44-fe16111ef642",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "x",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[x]",
            "summarizeBy": "none",
            "lineageTag": "610ea368-b6cb-56c2-a772-89d97065c984"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ROW ( \"x\", 0 )"
            }
          }
        ],
        "measures": [
          {
            "name": "Days Measured",
            "expression": "COUNT ( fact_city_day[PM25] )",
            "lineageTag": "db41d1ec-f57c-5401-8345-4863ea40b449",
            "formatString": "#,0"
          },
          {
            "name": "Cities",
            "expression": "DISTINCTCOUNT ( fact_city_day[City] )",
            "lineageTag": "0f7c8aab-147e-5623-a3b7-6f2895ab8065",
            "formatString": "0"
          },
          {
            "name": "Median PM2.5",
            "expression": "MEDIAN ( fact_city_day[PM25] )",
            "lineageTag": "9534eb12-d01a-514e-b87c-bd290467ac41",
            "formatString": "0"
          },
          {
            "name": "Median AQI",
            "expression": "MEDIAN ( fact_city_day[AQI_clean] )",
            "lineageTag": "2eb44a5f-54a6-5651-8b97-6ceac14c3e93",
            "formatString": "0"
          },
          {
            "name": "Median Official AQI",
            "expression": "MEDIAN ( fact_city_day[AQI_official] )",
            "lineageTag": "51d7f1ea-fb8d-5f55-97b5-4032aa7ec5ee",
            "formatString": "0"
          },
          {
            "name": "% Days Above Standard",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( fact_city_day ), fact_city_day[PM25] > 60 ), [Days Measured] )",
            "lineageTag": "f55d9e3a-b3dc-5601-aa6c-7cc7c3d684f2",
            "formatString": "0%"
          },
          {
            "name": "% Days Poor or Worse",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( COUNTROWS ( fact_city_day ), fact_city_day[AQI_clean] > 200 ),",
              "    CALCULATE ( COUNTROWS ( fact_city_day ), NOT ISBLANK ( fact_city_day[AQI_clean] ) )",
              ")"
            ],
            "lineageTag": "76748eab-fc74-5ed3-a46a-c7110e3d51f1",
            "formatString": "0%"
          },
          {
            "name": "Winter vs Monsoon",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Median PM2.5], dim_date[Month] IN { 11, 12, 1 } ),",
              "    CALCULATE ( [Median PM2.5], dim_date[Month] IN { 6, 7, 8, 9 } )",
              ")"
            ],
            "lineageTag": "3da2419d-2604-506c-bb72-47c4d37539ca",
            "formatString": "0.0"
          },
          {
            "name": "Worst City",
            "expression": [
              "VAR t = ADDCOLUMNS ( VALUES ( dim_city[City] ), \"@share\", [% Days Above Standard] )",
              "RETURN MAXX ( TOPN ( 1, FILTER ( t, NOT ISBLANK ( [@share] ) ), [@share], DESC ), dim_city[City] )"
            ],
            "lineageTag": "84cbde1d-4e7c-5ed6-9c54-ef6db4ad1007"
          },
          {
            "name": "Worst Month",
            "expression": [
              "VAR t = ADDCOLUMNS ( VALUES ( dim_date[MonthName] ), \"@pm\", [Median PM2.5] )",
              "RETURN MAXX ( TOPN ( 1, FILTER ( t, NOT ISBLANK ( [@pm] ) ), [@pm], DESC ), dim_date[MonthName] )"
            ],
            "lineageTag": "fc4f62ec-e260-503e-b6bc-4158aa28ea05"
          },
          {
            "name": "Main Pollutant",
            "expression": [
              "VAR t = ADDCOLUMNS (",
              "    FILTER ( VALUES ( fact_city_day[dominant_pollutant] ), NOT ISBLANK ( fact_city_day[dominant_pollutant] ) ),",
              "    \"@n\", CALCULATE ( COUNTROWS ( fact_city_day ) )",
              ")",
              "RETURN MAXX ( TOPN ( 1, t, [@n], DESC ), fact_city_day[dominant_pollutant] )"
            ],
            "lineageTag": "80cc2b33-7da5-57c0-bcb2-02f4d7eec4d0"
          },
          {
            "name": "Days",
            "expression": "COUNTROWS ( fact_city_day )",
            "lineageTag": "81cdad0c-8710-564b-92c4-83542f3546e4",
            "formatString": "#,0"
          },
          {
            "name": "PM2.5 (7-day avg)",
            "expression": "AVERAGEX ( DATESINPERIOD ( dim_date[Date], MAX ( dim_date[Date] ), -7, DAY ), [Median PM2.5] )",
            "lineageTag": "73898de6-1d5e-58f6-990c-d5519ca393f4",
            "formatString": "0"
          },
          {
            "name": "City Narrative",
            "expression": [
              "VAR c = SELECTEDVALUE ( dim_city[City], \"All 26 cities\" )",
              "RETURN",
              "    c & \": \" & FORMAT ( [% Days Above Standard], \"0%\" ) & \" of days over the PM2.5 limit\"",
              "        & \" · worst in \" & [Worst Month]"
            ],
            "lineageTag": "02447e59-28ed-5aa8-aea8-255f1c81b84d"
          },
          {
            "name": "Days in AQI Band",
            "expression": "CALCULATE ( COUNTROWS ( fact_city_day ), KEEPFILTERS ( NOT ISBLANK ( fact_city_day[AQI_Bucket_clean] ) ) )",
            "lineageTag": "431f69d6-d936-5258-9119-fd3f90c97a37",
            "formatString": "#,0"
          },
          {
            "name": "Median AQI Colour",
            "expression": [
              "VAR a = [Median AQI]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( a ), \"#E1E0D9\",",
              "        a <= 50, \"#EEA07C\",",
              "        a <= 100, \"#E27B52\",",
              "        a <= 200, \"#CF5A31\",",
              "        a <= 300, \"#AD3F1D\",",
              "        a <= 400, \"#832A12\",",
              "        \"#561A0B\"",
              "    )"
            ],
            "lineageTag": "5c6a7be1-03f4-534f-b7f1-e879c40bc8cc"
          },
          {
            "name": "Station PM2.5",
            "expression": "AVERAGE ( dim_station[pm25_mean] )",
            "lineageTag": "864c366c-1984-5da1-83a9-fe9a8dcd5dfc",
            "formatString": "0"
          },
          {
            "name": "Station % Above Standard",
            "expression": "AVERAGE ( dim_station[share_days_above_naaqs] )",
            "lineageTag": "568bc44b-ddc8-58b3-9613-8def9d553d93",
            "formatString": "0%"
          },
          {
            "name": "Actual",
            "expression": "AVERAGE ( ml_counterfactual[actual] )",
            "lineageTag": "6b5c36c0-341f-51f0-9b56-4e0d7b8d1e61",
            "formatString": "0"
          },
          {
            "name": "Expected Without Lockdown",
            "expression": "AVERAGE ( ml_counterfactual[predicted_bau] )",
            "lineageTag": "9a9b8974-2c73-5cdb-831f-8a1960252c14",
            "formatString": "0"
          },
          {
            "name": "Band Low",
            "expression": "AVERAGE ( ml_counterfactual[band_low] )",
            "lineageTag": "4c7fada6-d365-5668-833e-f040a5c94a0d",
            "formatString": "0"
          },
          {
            "name": "Band High",
            "expression": "AVERAGE ( ml_counterfactual[band_high] )",
            "lineageTag": "c30aae38-0506-5d0a-b42e-55923f476240",
            "formatString": "0"
          },
          {
            "name": "Actual (7-day)",
            "expression": "AVERAGEX ( DATESINPERIOD ( dim_date[Date], MAX ( dim_date[Date] ), -7, DAY ), [Actual] )",
            "lineageTag": "40ffa44c-4e67-5ec3-bbcc-ecd5f472d4c6",
            "formatString": "0"
          },
          {
            "name": "Expected (7-day)",
            "expression": "AVERAGEX ( DATESINPERIOD ( dim_date[Date], MAX ( dim_date[Date] ), -7, DAY ), [Expected Without Lockdown] )",
            "lineageTag": "973b2442-7fb3-558b-8558-10a5bea058ee",
            "formatString": "0"
          },
          {
            "name": "Band Low (7-day)",
            "expression": "AVERAGEX ( DATESINPERIOD ( dim_date[Date], MAX ( dim_date[Date] ), -7, DAY ), [Band Low] )",
            "lineageTag": "270ea153-aec1-50c5-bbbf-f4b46eb55a54",
            "formatString": "0"
          },
          {
            "name": "Band High (7-day)",
            "expression": "AVERAGEX ( DATESINPERIOD ( dim_date[Date], MAX ( dim_date[Date] ), -7, DAY ), [Band High] )",
            "lineageTag": "7ee7b59a-a47d-5266-9214-b944de18af13",
            "formatString": "0"
          },
          {
            "name": "Naive Change",
            "expression": "DIVIDE ( MEDIAN ( ml_lockdown_effect[naive_change_pct] ), 100 )",
            "lineageTag": "c8dc9afd-183c-5a9f-aac3-f0a87b621d4e",
            "formatString": "0%"
          },
          {
            "name": "Weather-Adjusted Change",
            "expression": "DIVIDE ( MEDIAN ( ml_lockdown_effect[weather_adjusted_change_pct] ), 100 )",
            "lineageTag": "0c2b34b0-490d-5710-81dd-a7eafc0f69e4",
            "formatString": "0%"
          },
          {
            "name": "PM2.5 Drop (Naive)",
            "expression": "CALCULATE ( [Naive Change], ml_lockdown_effect[pollutant] = \"PM25\" )",
            "lineageTag": "0ba7d493-6402-57d8-9ad3-315862045586",
            "formatString": "0%"
          },
          {
            "name": "PM2.5 Drop (Weather-Adjusted)",
            "expression": "CALCULATE ( [Weather-Adjusted Change], ml_lockdown_effect[pollutant] = \"PM25\" )",
            "lineageTag": "2b295d3f-e349-5c95-acea-43da22eee6b6",
            "formatString": "0%"
          },
          {
            "name": "NO2 Drop (Weather-Adjusted)",
            "expression": "CALCULATE ( [Weather-Adjusted Change], ml_lockdown_effect[pollutant] = \"NO2\" )",
            "lineageTag": "b293cb87-6799-519a-9e37-4f2d3b7ecdb2",
            "formatString": "0%"
          },
          {
            "name": "Weather Share of PM2.5 Drop",
            "expression": "1 - DIVIDE ( [PM2.5 Drop (Weather-Adjusted)], [PM2.5 Drop (Naive)] )",
            "lineageTag": "f24e2fa5-b964-5312-8e03-1f6cedea81f6",
            "formatString": "0%"
          },
          {
            "name": "Model Accuracy",
            "expression": "AVERAGE ( ml_predictions[model_correct] )",
            "lineageTag": "b3dd899e-9b68-5302-8f46-c7fdd5749593",
            "formatString": "0%"
          },
          {
            "name": "Baseline Accuracy",
            "expression": "AVERAGE ( ml_predictions[baseline_correct] )",
            "lineageTag": "978c28f6-2789-5e78-8c28-a9f29c633add",
            "formatString": "0%"
          },
          {
            "name": "Accuracy Gain",
            "expression": "[Model Accuracy] - [Baseline Accuracy]",
            "lineageTag": "c93efff8-ce20-56b5-9448-bc19e1d43034",
            "formatString": "+0.0%;-0.0%"
          },
          {
            "name": "Poor+ Recall (Model)",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( COUNTROWS ( ml_predictions ), ml_predictions[actual_category_rank] >= 4, ml_predictions[predicted_category_rank] >= 4 ),",
              "    CALCULATE ( COUNTROWS ( ml_predictions ), ml_predictions[actual_category_rank] >= 4 )",
              ")"
            ],
            "lineageTag": "b405b249-a809-5225-baa6-06a7b7397ae8",
            "formatString": "0%"
          },
          {
            "name": "Poor+ Recall (Baseline)",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( COUNTROWS ( ml_predictions ), ml_predictions[actual_category_rank] >= 4, ml_predictions[baseline_category_rank] >= 4 ),",
              "    CALCULATE ( COUNTROWS ( ml_predictions ), ml_predictions[actual_category_rank] >= 4 )",
              ")"
            ],
            "lineageTag": "869e9a27-0758-5fac-aee6-f32827e37ce3",
            "formatString": "0%"
          },
          {
            "name": "Accuracy On Change Days",
            "expression": [
              "CALCULATE (",
              "    [Model Accuracy],",
              "    FILTER ( ml_predictions, ml_predictions[actual_category] <> ml_predictions[baseline_category] )",
              ")"
            ],
            "lineageTag": "e00817a1-ea45-5358-937a-08a368c4dcc0",
            "formatString": "0%"
          },
          {
            "name": "Actual Category",
            "expression": "AVERAGE ( ml_predictions[actual_category_rank] )",
            "lineageTag": "7eff0a7c-38fb-581c-ac29-1f3965f3ff35",
            "formatString": "0"
          },
          {
            "name": "Predicted Category",
            "expression": "AVERAGE ( ml_predictions[predicted_category_rank] )",
            "lineageTag": "ee3803dd-808c-5551-9ac8-84732f65a778",
            "formatString": "0"
          },
          {
            "name": "Confusion Days",
            "expression": "SUM ( ml_confusion[days] )",
            "lineageTag": "edb6f6be-fd95-5ee8-bae4-6e74f9d5bdf4",
            "formatString": "#,0"
          },
          {
            "name": "Confusion Row %",
            "expression": [
              "DIVIDE (",
              "    [Confusion Days],",
              "    CALCULATE ( [Confusion Days], REMOVEFILTERS ( ml_confusion[predicted], ml_confusion[predicted_rank] ) )",
              ")"
            ],
            "lineageTag": "dcb83603-0d97-59b7-904b-2df6c1a7c578",
            "formatString": "0%"
          },
          {
            "name": "Metric Value",
            "expression": "AVERAGE ( ml_model_metrics[value] )",
            "lineageTag": "c39320c3-6908-56d8-9242-130506ddf0e5",
            "formatString": "0.00"
          },
          {
            "name": "Importance",
            "expression": "SUM ( ml_feature_importance[importance] )",
            "lineageTag": "5cac5099-0493-5fea-8d52-06f4416982be",
            "formatString": "0.000"
          },
          {
            "name": "Cleaning Steps",
            "expression": "COUNTROWS ( cleaning_log )",
            "lineageTag": "e02282d9-a6d0-5c0c-b7a4-55ff82dcfb29",
            "formatString": "0"
          },
          {
            "name": "AQI Values Rebuilt",
            "expression": "CALCULATE ( COUNTROWS ( fact_city_day ), NOT fact_city_day[aqi_source] IN { \"official\", \"missing\" } )",
            "lineageTag": "5950442b-53f0-594c-92e2-6d343b759182",
            "formatString": "#,0"
          },
          {
            "name": "Sensor Faults Removed",
            "expression": "SUM ( fact_city_day[pm_fault_flag] )",
            "lineageTag": "9897b1c1-be76-5e4b-ac5a-a2d33c162648",
            "formatString": "#,0"
          },
          {
            "name": "Missing Before %",
            "expression": "DIVIDE ( AVERAGE ( data_quality[missing_raw_pct] ), 100 )",
            "lineageTag": "d83190b5-9a90-5b59-88dd-45fd9a537453",
            "formatString": "0%"
          },
          {
            "name": "Missing After %",
            "expression": "DIVIDE ( AVERAGE ( data_quality[missing_clean_pct] ), 100 )",
            "lineageTag": "ade64d34-cc33-50a0-b609-095f1c34c8eb",
            "formatString": "0%"
          }
        ]
      },
