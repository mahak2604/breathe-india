                "    Typed = Table.TransformColumnTypes(Nulls, {{\"City\", type text}, {\"latitude\", type number}, {\"longitude\", type number}, {\"elevation_m\", type number}, {\"population\", type number}, {\"State\", type text}, {\"Region\", type text}, {\"is_coastal\", Int64.Type}, {\"first_date\", type date}, {\"last_date\", type date}, {\"days_with_data\", Int64.Type}, {\"aqi_days\", Int64.Type}, {\"pm25_level\", type number}, {\"seasonality\", type number}, {\"cluster\", type text}}, \"en-US\")",
